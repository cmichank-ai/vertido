# Vertido — lanes de distribución. Secretos vía variables de entorno (GitHub Actions secrets).
default_platform(:android)

platform :android do
  desc "Build .aab firmado y subida a pista interna de Play"
  lane :beta do
    sh "cd .. && npm ci && npm run build && npx cap sync android"
    gradle(project_dir: "android", task: "bundle", build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => ENV["ANDROID_KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"],
      })
    upload_to_play_store(track: "internal", aab: "android/app/build/outputs/bundle/release/app-release.aab", json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"], skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true)
  end
  desc "Promover de interna a producción con lanzamiento escalonado al 10%"
  lane :release do
    upload_to_play_store(track: "internal", track_promote_to: "production", rollout: "0.1", json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"], skip_upload_aab: true, skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true)
  end
end

platform :ios do
  desc "Build firmado y subida a TestFlight"
  lane :beta do
    setup_ci
    app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_content: ENV["ASC_KEY_CONTENT"], is_key_content_base64: true)
    sh "cd .. && npm ci && npm run build && npx cap sync ios && cd ios/App && pod install"
    match(type: "appstore", app_identifier: "com.vertido.game", readonly: true, git_url: ENV["MATCH_GIT_URL"])
    increment_build_number(xcodeproj: "ios/App/App.xcodeproj", build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M"))
    build_app(workspace: "ios/App/App.xcworkspace", scheme: "App", export_method: "app-store")
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
