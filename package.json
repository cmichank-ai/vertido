{
  "name": "vertido",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vertido — sort puzzle hybrid-casual (web + Capacitor)",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "single": "node scripts/single.mjs",
    "test:quick": "GEN_LEVELS=60 node --test tests/*.test.mjs",
    "serve": "npx --yes serve -l 5173 .",
    "cap:init": "npx cap init Vertido com.vertido.game --web-dir dist",
    "cap:sync": "npm run build && npx cap sync",
    "worker:dev": "cd worker && npx wrangler dev",
    "worker:deploy": "cd worker && npx wrangler deploy"
  },
  "engines": { "node": ">=20" }
}
